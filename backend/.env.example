# Safe local default. Explicit Wi-Fi development only: HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000
RUNNER_MODE=mock
# Physical radio switching is unsupported. This runs the real APK's deterministic demo hook.
NETWORK_STRATEGY=DETERMINISTIC_DEMO
ADB_PATH=adb
# Required when multiple devices are online. Copy an exact serial from adb devices.
DEFAULT_DEVICE_SERIAL=
DEMOSHOP_PACKAGE=com.pranay.demoshop
REPROAI_PACKAGE=com.pranay.reproai
# Optional debug-only reset endpoint; enable only on a trusted demo LAN.
ENABLE_DEMO_CONTROLS=false
